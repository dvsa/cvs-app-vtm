{
  "name": "cvs-app-vtm",
  "version": "1.51",
  "description": "DVSA CVS Vehicle Testing Management Application",
  "main": "index.js",
  "engines": {
    "node": "24.15.*",
    "npm": "11.12.*"
  },
  "scripts": {
    "ng": "ng",
    "config": "bun run ./setenv.ts",
    "start": "bun run ./setenv.ts --environment=dev && ng serve",
    "start-no-cache": "rm -rf .angular && bun run ./setenv.ts --environment=dev && ng serve",
    "start:dev1": "bun --env-file=.env.dev1 run ./setenv.ts && ng serve",
    "start:dev2": "bun --env-file=.env.dev2 run ./setenv.ts && ng serve",
    "build": "ng build --optimization --progress --aot",
    "watch": "ng build --watch",
    "security-checks": "git secrets --scan && git secrets --register-aws && git log -p --diff-filter=d -- . ':!*.json' -n 100 | scanrepo",
    "lint": "biome check src",
    "lint:fix": "npm run lint -- --write",
    "test": "jest --colors --maxWorkers=50% --coverage",
    "test:workflow": "jest --maxWorkers=50%",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --runInBand --watchAll=false --reporters=default",
    "prepare": "husky && ts-patch install -s",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org driver-and-vehicle-standards-a --project vehicle-test-management ./dist && sentry-cli sourcemaps upload --org driver-and-vehicle-standards-a --project vehicle-test-management ./dist",
    "generate:test-type-groupings": "bun run scripts/generate-test-type-groupings.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-browser-dynamic": "^22.1.6",
    "@angular/router": "22.1.6",
    "@azure/msal-angular": "^3.0.24",
    "@azure/msal-browser": "^3.24.0",
    "@dvsa/cvs-microservice-common": "^1.6.0",
    "@dvsa/cvs-type-definitions": "^17.2.1",
    "@ngneat/cashew": "^4.1.0",
    "@ngrx/effects": "^22.0.0",
    "@ngrx/entity": "^22.0.0",
    "@ngrx/operators": "^22.0.0",
    "@ngrx/router-store": "^22.0.0",
    "@ngrx/store": "^22.0.0",
    "@ngrx/store-devtools": "^22.0.0",
    "@sentry/angular": "^10.47.0",
    "@sentry/types": "^10.47.0",
    "accessible-autocomplete": "^3.0.1",
    "angular-google-tag-manager": "^1.13.0",
    "assert": "^2.1.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "dayjs": "^1.11.20",
    "deep-object-diff": "^1.1.9",
    "emoji-regex": "^10.4.0",
    "govuk-frontend": "^4.8.0",
    "jszip": "^3.10.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "lodash.clonedeep": "^4.5.0",
    "lodash.merge": "^4.6.2",
    "ngrx-store-localstorage": "20.1.0",
    "rxjs": "^7.8.1",
    "stream-browserify": "^3.0.0",
    "tslib": "^2.7.0",
    "uuid": "^14.0.0",
    "validate-govuk-date": "^1.0.3",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.6",
    "@babel/core": "^7.23.9",
    "@biomejs/biome": "1.9.0",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.2",
    "@dvsa/biome-config": "0.2.0",
    "@ngrx/schematics": "^22.0.0",
    "@sentry/cli": "^2.32.2",
    "@types/bun": "^1.4.2",
    "@types/jest": "^29.5.14",
    "@types/json-server": "^0.14.7",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^24.13.1",
    "@types/uuid": "^9.0.8",
    "babel-loader": "^9.1.3",
    "bun": "^1.4.2",
    "commitlint-plugin-function-rules": "^3.1.0",
    "husky": "^9.0.11",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-preset-angular": "^16.1.2",
    "jest-sonar-reporter": "^2.0.0",
    "json-server": "^0.17.3",
    "lint-staged": "^15.2.10",
    "multer": "^2.3.0",
    "sonarqube-scanner": "^3.3.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.1.2",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@nx/nx-darwin-arm64": "18.0.4",
    "@nx/nx-darwin-x64": "18.0.4",
    "@nx/nx-linux-x64-gnu": "18.0.4",
    "@nx/nx-win32-x64-msvc": "18.0.4"
  },
  "overrides": {
    "angular-google-tag-manager": {
      "@angular/common": "$@angular/common",
      "@angular/compiler": "$@angular/compiler"
    },
    "ngrx-store-localstorage": {
      "@ngrx/store": "$@ngrx/store"
    },
    "qs": "^6.16.0",
    "fast-uri": "^4.1.4",
    "multer": "^2.3.0",
    "brace-expansion": "^5.0.9",
    "js-yaml": "^4.2.0"
  },
  "lint-staged": {
    "*.{js,ts,mjs,css,md,ts,json}": "npm run lint:fix -- --no-errors-on-unmatched"
  },
  "jestSonar": {
    "reportPath": "./coverage",
    "reportFile": "test-report.xml",
    "indent": 4
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvsa/cvs-app-vtm.git"
  },
  "author": "DVSA",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dvsa/cvs-app-vtm/issues"
  },
  "browser": {
    "stream": "stream-browserify"
  },
  "homepage": "https://github.com/dvsa/cvs-app-vtm#readme"
}
