{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noCheck": true,
    "outDir": "./out-tsc/spec",
    "module": "ES2022",
    "allowJs": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "esModuleInterop": true
  },
  "files": [
    "./setup-vitest.ts",
    "./test-providers.ts",
    "./vitest-globals.d.ts"
  ],
  "angularCompilerOptions": {
    "strictTemplates": false
  },
  "include": [
    "./src/**/*.mock.ts",
    "./src/**/*.spec.ts",
    "./src/**/__mocks__/**/*.ts",
    "./src/**/*.d.ts"
  ]
}
