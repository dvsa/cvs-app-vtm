{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./out-tsc/spec",
    "module": "CommonJs",
    "allowJs": true,
    "types": [
      "node",
      "jest"
    ],
    "esModuleInterop": true
  },
  "files": [
    "setup-jest.ts",
    "jest-global-mocks.ts",
    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
